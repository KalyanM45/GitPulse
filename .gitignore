# ── Secrets ───────────────────────────────────────────────────────────────────
# backend/.env holds GITHUB_TOKEN (repo scope) and the MongoDB Atlas URI.
# Ignore every env file; .env.example is the documented exception.
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
backend/venv/
**/__pycache__/
**/*.py[cod]
*.egg-info/
.pytest_cache/

# ── Node / Next ───────────────────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo

# ── Build / tooling ───────────────────────────────────────────────────────────
dist/
build/
.vercel/
shots/
*.log

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# Terraform: state can hold infrastructure details; providers are re-downloaded.
# (.terraform.lock.hcl IS committed, to pin provider versions.)
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars
infra/*.tfplan

# Private developer notes (deployment, secrets locations, costs). Local only.
docs/developer/
