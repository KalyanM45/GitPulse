# GitPulse backend configuration.
# Copy to backend/.env for local development. In production these are set in
# your host's dashboard (Render) or Secret Manager (GCP), never committed.
# Full reference: docs/CONFIGURATION.md

# ── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DB_NAME=github_analytics

# ── Authentication (Firebase) ───────────────────────────────────────────────
# Firebase console -> Project settings -> General -> Project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── GitHub tokens ───────────────────────────────────────────────────────────
# Encrypts every user's GitHub token stored in MongoDB. Long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never change it once set (stored tokens would become unreadable), and use the
# same value everywhere the backend runs (Render, GitHub Actions, GCP).
TOKEN_ENCRYPTION_KEY=

# ── Invite-only program ─────────────────────────────────────────────────────
# invite = only admins and invited emails get their own dashboard
# open   = any verified account does (each user still sees only their own data)
ACCESS_MODE=invite
# Your sign-in email(s), comma-separated. Admins manage requests at /admin.
ADMIN_EMAILS=you@example.com
# Optional extra invitees set here instead of from /admin.
ALLOWED_EMAILS=

# ── Read-only demo ──────────────────────────────────────────────────────────
# GitHub account whose dashboard signed-in visitors can browse at /demo.
# Empty = no demo.
DEMO_GITHUB_LOGIN=
# Hide private repositories (names, traffic, stars) from the demo.
DEMO_HIDE_PRIVATE_REPOS=true

# ── Email when someone requests access (optional) ───────────────────────────
# Gmail: smtp.gmail.com, port 587, your address, and an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# Unset = requests are still saved and shown on /admin, just not emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Who receives them (defaults to ADMIN_EMAILS).
NOTIFY_EMAILS=
# Frontend URL, for the "Review on GitPulse" link in those emails.
APP_URL=http://localhost:3000

# ── Scheduling ──────────────────────────────────────────────────────────────
# In-process follower sync every N minutes. Set ENABLE_SCHEDULER=false where an
# external scheduler runs `python -m app.cron` instead (Cloud Scheduler on GCP).
ENABLE_SCHEDULER=true
SYNC_INTERVAL_MINUTES=60

# ── Legacy single-user data ─────────────────────────────────────────────────
# The one account the app tracked before multi-user support. Whoever connects
# this GitHub account inherits its existing history.
GITHUB_USERNAME=

# ── CORS ────────────────────────────────────────────────────────────────────
# Browser origins allowed to call the API (comma-separated). Default "*".
CORS_ORIGINS=http://localhost:3000
