# Legacy: the one account the app tracked before multi-user support. Whoever
# connects this GitHub account inherits its existing history. Users' own tokens
# are stored (encrypted) in MongoDB when they click "Connect GitHub".
GITHUB_USERNAME=your_github_username
MONGODB_URI=mongodb://localhost:27017
DB_NAME=github_analytics
SYNC_INTERVAL_MINUTES=60


# ── Authentication (Firebase) ──
# Firebase console -> Project settings -> General -> Project ID
FIREBASE_PROJECT_ID=your-firebase-project-id
# Only these emails can use the dashboard (comma-separated). Empty = any verified user.
ALLOWED_EMAILS=you@example.com

# Encrypts users' GitHub tokens in MongoDB. Long random string; never change it once
# set (stored tokens would become unreadable). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_ENCRYPTION_KEY=
